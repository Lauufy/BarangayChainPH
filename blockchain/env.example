# Copy this file to .env and fill in the values.
# Never commit .env, it holds a private key.

# Address of the blockchain node (from Alchemy or Infura)
RPC_URL=

# Private key of the wallet that signs transactions
PRIVATE_KEY=

# Address of the deployed PermitRegistry contract
REGISTRY_ADDRESS=

# Only needed to verify the contract source on the explorer
ETHERSCAN_API_KEY=