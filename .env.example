APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# For production, set APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
PRIVACY_POLICY_VERSION=1.0

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# For production, set SESSION_ENCRYPT=true.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# CSP starts in report-only mode. Set true only after reviewing violation reports.
CSP_ENFORCE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use server-side S3 credentials and endpoint from Supabase Storage settings; keep the bucket private.
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# For production, configure a real mailer instead of "log".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required for server-side CAPTCHA verification during registration.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=your-device-id

# on hosting providers like Render, you can set this to "*" to trust all proxies
TRUSTED_PROXIES=

BLOCKCHAIN_NODE_PATH=

# Blockchain settings (see config/blockchain.php). Never put real keys in this file.
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io
BLOCKCHAIN_CONTRACT=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_ISSUER_KEY=

# Optional Docker startup synchronization for the selected network. Set all three together.
BLOCKCHAIN_DEPLOY_TX=
BLOCKCHAIN_DEPLOY_VERSION=
BLOCKCHAIN_DEPLOY_OWNER=

# Optional named overrides for Sepolia. Omit to use the legacy settings above.
# BLOCKCHAIN_SEPOLIA_CONTRACT=
# BLOCKCHAIN_SEPOLIA_RPC_URL=
# BLOCKCHAIN_SEPOLIA_ISSUER_KEY=

BLOCKCHAIN_MAINNET_CONTRACT=
BLOCKCHAIN_MAINNET_RPC_URL=
BLOCKCHAIN_MAINNET_ISSUER_KEY=
BLOCKCHAIN_MAINNET_WRITES_ENABLED=false
